# ===================== General =====================
ENVIRONMENT=development
LOG_LEVEL=info

# ===================== Postgres =====================
POSTGRES_USER=novagen
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=novagen
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://novagen:change_me_in_prod@postgres:5432/novagen

# ===================== MongoDB =====================
MONGO_INITDB_ROOT_USERNAME=novagen
MONGO_INITDB_ROOT_PASSWORD=change_me_in_prod
MONGO_URL=mongodb://novagen:change_me_in_prod@mongo:27017

# ===================== Neo4j =====================
NEO4J_AUTH=neo4j/change_me_in_prod
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_prod

# ===================== Redis =====================
REDIS_URL=redis://redis:6379/0

# ===================== MinIO (object storage) =====================
MINIO_ROOT_USER=novagen
MINIO_ROOT_PASSWORD=change_me_in_prod
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=novagen-files

# ===================== Auth =====================
JWT_SECRET=change_me_in_prod_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ===================== Internal automation (backend-only, never sent to frontend) ===
SNS_WORKBENCH_WEBHOOK_URL=

# ===================== External literature search (optional) =====================
NCBI_API_KEY=

# ===================== Molecular docking (optional) =====================
# Path to the standalone AutoDock Vina executable, or just "vina" if it's on
# your PATH. Download from https://github.com/ccsb-scripps/AutoDock-Vina/releases
VINA_EXECUTABLE_PATH=vina

# ===================== Internal service-to-service URLs (Docker Compose defaults) =====================
INTERNAL_AUTOMATION_URL=http://automation-service:8009
INTERNAL_REPORT_SERVICE_URL=http://report-service:8006
INTERNAL_NOTIFICATION_SERVICE_URL=http://notification-service:8007

# ===================== Frontend =====================
NEXT_PUBLIC_API_URL=http://localhost:8000
