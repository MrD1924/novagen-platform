# ===================== General =====================
ENVIRONMENT=development
LOG_LEVEL=info

# ===================== Postgres (native install) =====================
POSTGRES_USER=novagen
POSTGRES_PASSWORD=change_me
POSTGRES_DB=novagen
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://novagen:change_me@localhost:5432/novagen

# ===================== MongoDB (native install) =====================
MONGO_INITDB_ROOT_USERNAME=novagen
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_URL=mongodb://novagen:change_me@localhost:27017

# ===================== Neo4j (native install) =====================
NEO4J_AUTH=neo4j/change_me
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ===================== Redis (native install) =====================
REDIS_URL=redis://localhost:6379/0

# ===================== MinIO (native install) =====================
MINIO_ROOT_USER=novagen
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=novagen-files

# ===================== Auth =====================
JWT_SECRET=change_me_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ===================== Internal automation (optional) =====================
SNS_WORKBENCH_WEBHOOK_URL=

# ===================== External literature search (optional) =====================
NCBI_API_KEY=

# ===================== Molecular docking (optional) =====================
# Full path to vina.exe (or just "vina" if you added it to your system PATH).
# Download from https://github.com/ccsb-scripps/AutoDock-Vina/releases
VINA_EXECUTABLE_PATH=C:\vina\vina.exe

# ===================== Frontend =====================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================== Service-to-service URLs (native install — all localhost, distinct ports) =====================
AUTH_SERVICE_URL=http://localhost:8001
DRUG_SERVICE_URL=http://localhost:8002
PREDICTION_SERVICE_URL=http://localhost:8003
ANALYTICS_SERVICE_URL=http://localhost:8004
EXPERIMENT_SERVICE_URL=http://localhost:8005
REPORT_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
WORKFLOW_SERVICE_URL=http://localhost:8008

# These two are what actually matter for native mode — the Docker-default values
# in .env.example would silently fail to resolve outside a Docker network.
INTERNAL_AUTOMATION_URL=http://localhost:8009
INTERNAL_REPORT_SERVICE_URL=http://localhost:8006
INTERNAL_NOTIFICATION_SERVICE_URL=http://localhost:8007
